# Copy this file to .env and fill in real values before running
# docker compose up. Never commit the real .env file.
#
# Generate one with: openssl rand -hex 16
BADAPI_ADMIN_KEY=changeme

# Only needed if hosting via Cloudflare Tunnel (docker compose --profile tunnel up).
# Get this from the Cloudflare Zero Trust dashboard - see HOSTING.md.
CLOUDFLARE_TUNNEL_TOKEN=
